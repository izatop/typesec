{
  "name": "typesec",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.4.3",
      "radash": "12.1.1",
      "chalk": "6.0.1",
      "zod": "4.6.7",
      "@commander-js/extra-typings": "15.0.0",
      "commander": "15.0.0"
    },
    "catalogs": {
      "build": {
        "oxlint": "^1.89.0",
        "oxfmt": "^0.74.0"
      }
    }
  },
  "scripts": {
    "check": "bun tsgo -b packages",
    "check:watch": "bun tsgo -b packages -w",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:watch": "bun --watchtest",
    "audit": "bun audit --audit-level=high",
    "lint": "oxlint --quiet",
    "sync": "bun typesec-sync",
    "up": "bun update -ri --latest",
    "fmt:check": "oxfmt . --check",
    "fmt:write": "oxfmt . --write"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@typesec/bootstrap": "workspace:*",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build"
  },
  "packageManager": "bun@1.4.4"
}
